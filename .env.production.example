APP_ENV=production
DETECTOR_CHECKPOINT=checkpoints/best.pt
SAM_CHECKPOINT=checkpoints/sam2.1_hiera_tiny.pt
SAM_MODEL_TYPE=tiny
RECIPES_PATH=data/recipes.json
DATABASE_URL=postgresql://your-prod-db-url-here

# AWS S3 weight download configurations
BUCKET_NAME=your-production-bucket-name
S3_PREFIX=checkpoints

# Production credentials - MUST be overridden in production host/ECS task definition
API_KEY=your-production-api-key
JWT_SECRET=your-production-jwt-secret-change-me
